DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=1
# Add the server computer's local IPv4 address for manual network launches.
# start_server.cmd detects and supplies this address automatically.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,192.168.0.187

POSTGRES_DB=hospital_db
POSTGRES_USER=hospital_user
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Railway: set these as service variables, rather than uploading a .env file.
# DJANGO_ENV=production
# DJANGO_DEBUG=0
# DJANGO_SECRET_KEY=<generate-a-random-secret-at-least-50-characters-long>
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# ADVERTISEMENT_ROOT=/data/advertisements
# Custom domains (the Railway public domain is accepted automatically):
# DJANGO_ALLOWED_HOSTS=hospital.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://hospital.example.com
